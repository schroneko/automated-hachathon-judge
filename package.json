{
  "name": "automated-hachathon-judge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schroneko/automated-hachathon-judge.git"
  },
  "bugs": {
    "url": "https://github.com/schroneko/automated-hachathon-judge/issues"
  },
  "homepage": "https://github.com/schroneko/automated-hachathon-judge#readme",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:worker",
    "build:client": "vite build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "dev:client": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
