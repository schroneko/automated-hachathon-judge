{
  "name": "hackathon-nukoevi-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "JUDGE_DB",
      "database_name": "wordplay-arcade-budget",
      "database_id": "9885f668-2887-43cc-81d9-df9a89e1bec1",
      "migrations_dir": "migrations",
      "migrations_table": "devday_judge_migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "SCORING_QUEUE", "queue": "devday-judge-20261018" },
      { "binding": "EXPLANATION_QUEUE", "queue": "devday-judge-explanations-20261018" }
    ],
    "consumers": [
      { "queue": "devday-judge-20261018", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 8, "max_retries": 0 },
      { "queue": "devday-judge-explanations-20261018", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 8, "max_retries": 0 }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JudgeState", "ScorerBucketContainer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["ScorerBucketContainer"]
    }
  ],
  "routes": [
    {
      "pattern": "hackathon.nukoevi.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "JUDGING_ENABLED": "true",
    "SUBMISSIONS_OPEN": "true"
  }
}
