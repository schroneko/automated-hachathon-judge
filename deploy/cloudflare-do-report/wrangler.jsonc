{
  "name": "cloudflare-do-report",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cloudflare-do-report.nukoevi.app",
      "custom_domain": true
